#!/usr/bin/env bash
set -euo pipefail

workspace_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
workspace_site="phit-$(basename -- "$workspace_root")"

if ! command -v herd >/dev/null 2>&1; then
    echo "Workspace cleanup requires herd on PATH." >&2
    exit 1
fi

# Remove only this workspace's link; source and rendered files remain intact.
herd unlink "$workspace_site"
